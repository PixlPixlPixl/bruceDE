{
  "private": true,
  "name": "browser-app",
  "version": "0.1.0",
  "description": "Icebox is a plugin-first desktop workspace: an empty docking canvas you fill with panels.",
  "dependencies": {
    "@icebox/plugin-api": "0.1.0",
    "@icebox/plugin-runtime": "0.1.0",
    "@icebox/ui-kit": "0.1.0",
    "@theia/core": "1.77.0",
    "@theia/editor": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/markers": "1.77.0",
    "@theia/messages": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/process": "1.77.0",
    "@theia/terminal": "1.77.0",
    "@theia/workspace": "1.77.0",
    "workspace-core": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.77.0"
  },
  "scripts": {
    "bundle": "npm run rebuild && node ../node_modules/@theia/cli/bin/theia.js build --mode development && node ../scripts/brand-generated-html.mjs .",
    "rebuild": "node ../node_modules/@theia/cli/bin/theia.js rebuild:browser --cacheRoot ..",
    "start": "node ../node_modules/@theia/cli/bin/theia.js start",
    "watch": "npm run rebuild && node ../node_modules/@theia/cli/bin/theia.js build --watch --mode development"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Icebox",
        "defaultTheme": "dark",
        "preferences": {
          "workbench.colorTheme": "dark"
        }
      }
    }
  }
}
