{
  "private": true,
  "name": "workspace-core",
  "version": "0.1.0",
  "type": "module",
  "description": "User-controlled blank-canvas docking workspace for Icebox.",
  "keywords": [
    "theia-extension"
  ],
  "dependencies": {
    "@icebox/plugin-api": "0.1.0",
    "@icebox/plugin-runtime": "0.1.0",
    "@icebox/ui-kit": "0.1.0",
    "@lumino/widgets": "2.7.5",
    "@theia/core": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/terminal": "1.77.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
    "watch": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --watch"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/workspace-core-frontend-module",
      "backend": "lib/node/workspace-core-backend-module"
    }
  ],
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./lib/*": "./lib/*.js"
  }
}
