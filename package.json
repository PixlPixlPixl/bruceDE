{
  "private": true,
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "scripts": {
    "build:workspace-core": "npm --prefix workspace-core run build",
    "build:browser": "npm run build:workspace-core && npm --prefix browser-app run bundle",
    "build:electron": "npm run build:workspace-core && npm --prefix electron-app run bundle",
    "prepare": "lerna run prepare",
    "postinstall": "theia check:theia-version",
    "start:browser": "npm --prefix browser-app start",
    "start:electron": "npm --prefix electron-app start",
    "watch:browser": "lerna run --parallel watch --ignore electron-app",
    "watch:electron": "lerna run --parallel watch --ignore browser-app"
  },
  "devDependencies": {
    "lerna": "^8.2.4"
  },
  "workspaces": [
    "browser-app",
    "electron-app",
    "workspace-core"
  ]
}
