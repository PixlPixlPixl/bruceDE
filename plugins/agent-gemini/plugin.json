{
    "id": "icebox.agent-gemini",
    "name": "Gemini CLI",
    "version": "0.1.0",
    "apiVersion": 1,
    "description": "Declares the Gemini CLI agent CLI for agent chat. No code: the descriptor is manifest data.",
    "entrypoints": {},
    "contributes": {
        "agents": [
            {
                "id": "gemini",
                "name": "Gemini CLI",
                "protocol": "acp",
                "command": "gemini",
                "args": [
                    "--experimental-acp"
                ]
            }
        ]
    }
}
