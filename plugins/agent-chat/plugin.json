{
    "id": "icebox.agent-chat",
    "name": "Agent Chat",
    "version": "0.1.0",
    "apiVersion": 1,
    "description": "Chat sessions with a local agent CLI over ACP or Pi RPC.",
    "entrypoints": {
        "frontend": "./dist/frontend.js",
        "backend": "./dist/backend.js"
    },
    "dependencies": {
        "icebox.workspace": "^0.1.0"
    },
    "contributes": {
        "panels": [
            {
                "id": "agent-chat.conversation",
                "title": "Agent Chat"
            }
        ],
        "commands": [
            {
                "id": "icebox.agent-chat.open",
                "title": "Agent: Open Chat"
            }
        ],
        "services": [
            "agent.sessions"
        ]
    }
}
