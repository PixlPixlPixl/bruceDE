{
    "id": "icebox.agent-chat",
    "name": "Agent Chat",
    "version": "0.1.0",
    "apiVersion": 1,
    "description": "Agent chat panels: transcript, sessions, protocol label and composer.",
    "entrypoints": {
        "frontend": "./dist/frontend.js",
        "backend": "./dist/backend.js"
    },
    "dependencies": {
        "icebox.workspace": "^0.1.0",
        "icebox.agent-orchestrator": "^0.1.0"
    },
    "contributes": {
        "panels": [
            {
                "id": "agent-chat.conversation",
                "title": "Agent Chat"
            }
        ],
        "commands": [
            {
                "id": "icebox.agent-chat.open",
                "title": "Open Agent Chat"
            }
        ],
        "services": [
            "agent.sessions",
            "agent.chat"
        ]
    }
}
