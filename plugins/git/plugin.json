{
    "id": "icebox.git",
    "name": "Git",
    "version": "0.1.0",
    "apiVersion": 1,
    "description": "Staged, changed and untracked files from the active work tree.",
    "entrypoints": {
        "frontend": "./dist/frontend.js",
        "backend": "./dist/backend.js"
    },
    "dependencies": {
        "icebox.workspace": "^0.1.0"
    },
    "contributes": {
        "panels": [
            {
                "id": "git.changes",
                "title": "Git"
            }
        ],
        "commands": [
            {
                "id": "icebox.git.open",
                "title": "Open Git"
            }
        ],
        "services": [
            "git.repository"
        ]
    }
}
