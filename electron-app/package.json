{
  "private": true,
  "name": "electron-app",
  "productName": "Icebox",
  "version": "0.1.0",
  "description": "Icebox is a plugin-first desktop workspace: an empty docking canvas you fill with panels.",
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@icebox/plugin-api": "0.1.0",
    "@icebox/plugin-runtime": "0.1.0",
    "@icebox/ui-kit": "0.1.0",
    "@theia/core": "1.77.0",
    "@theia/editor": "1.77.0",
    "@theia/electron": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/markers": "1.77.0",
    "@theia/messages": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/process": "1.77.0",
    "@theia/terminal": "1.77.0",
    "@theia/workspace": "1.77.0",
    "workspace-core": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.77.0",
    "electron": "44.9.1"
  },
  "scripts": {
    "bundle": "npm run rebuild && npm run native:ffmpeg && node ../node_modules/@theia/cli/bin/theia.js build --mode development && node ../scripts/brand-generated-html.mjs .",
    "native:ffmpeg": "node ../scripts/ensure-ffmpeg-addon.mjs",
    "rebuild": "node ../node_modules/@theia/cli/bin/theia.js rebuild:electron --cacheRoot ..",
    "start": "node ../node_modules/@theia/cli/bin/theia.js start",
    "watch": "npm run rebuild && npm run native:ffmpeg && node ../node_modules/@theia/cli/bin/theia.js build --watch --mode development"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Icebox",
        "defaultTheme": "dark",
        "preferences": {
          "workbench.colorTheme": "dark"
        }
      }
    }
  }
}
